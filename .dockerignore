# Root build context allowlist: container Dockerfiles that COPY repo-level
# paths build with the repo root as their context (each worker's
# wrangler.jsonc sets image_build_context), so only the paths their COPY
# lines name enter the context. Everything else, including node_modules
# and .git, stays out. Keep every entry paired with a Dockerfile COPY
# line (export-worker: src + the exports protocol; backup-worker: src +
# the backups slot + the telemetry service token).
*
!apps
!apps/export-worker
!apps/export-worker/src
!apps/backup-worker
!apps/backup-worker/src
!convex
!convex/operations
!convex/operations/exports
!convex/operations/exports/protocol.ts
!convex/operations/backups
!convex/operations/backups/slot.ts
!convex/operations/telemetry
!convex/operations/telemetry/serviceToken.ts
