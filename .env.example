# Kiero environment example: variable NAMES only, values are never committed.
# Copy to .env for local use; .env and .env.* are git-ignored (this file is
# the only tracked exception).

# Server-only secrets. They are read exclusively in server runtimes
# (Convex functions, Cloudflare Workers, Container executors) and are never
# imported from apps/web client code. Never give a secret a VITE_ prefix:
# only that prefix reaches the client bundle.

# OpenRouter API key used by server-owned model routing (@tanstack/ai-openrouter).
OPENROUTER_API_KEY=

# B1 sign-in (server-only names; set with `npx convex env set` on the deployment):
# Resend application-email delivery (sign-in codes; B3 invitations later).
RESEND_API_KEY=
# Optional verified sender ("Kiero <no-reply@yourdomain.pl>"); defaults to
# Resend's sandbox sender on the free plan.
RESEND_FROM=
# Google OAuth client (owner-created Google Cloud OAuth client + consent
# screen; redirect: <deployment .convex.site URL>/api/auth/callback/google).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Client-safe, non-secret configuration. The VITE_ prefix intentionally
# exposes these to the web bundle; only values that are safe to publish
# may ever appear here.
# Convex deployment URL for the web client (populated by the Convex setup ticket).
VITE_CONVEX_URL=
# Optional media-gateway Worker URL (public, non-secret): D4's capture
# uploads and D3/H3's authorized media reads. Without it the app runs and
# exactly those surfaces say so.
VITE_GATEWAY_URL=
