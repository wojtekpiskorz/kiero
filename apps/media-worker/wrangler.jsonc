// apps/media-worker/wrangler.jsonc: the EU media Container executor
// (audio conversion/segmentation and the image byte channel).
//
// The TOP-LEVEL block targets LOCAL DEV names only; staging/alpha are named
// environments (`--env staging` / `--env alpha-production`) and can never be
// hit by a bare `wrangler deploy`.
//
// EU placement: the pinned wrangler 4.130.0 supports container jurisdiction
// constraints, so they are SET in every scope.
//
// The R2 media S3 credentials (`R2_MEDIA_ACCESS_KEY_ID` /
// `R2_MEDIA_SECRET_ACCESS_KEY`) are Worker secrets. Without them every byte
// operation answers the typed `not_configured` refusal, never a fabricated
// read.
//
// Media bytes live in the eu-jurisdiction R2 bucket (gateway binding); this
// container addresses it via S3 credentials (see
// infra/bindings/media-export-workers.md), not via a Worker binding.
// No account_id committed; the account comes from `wrangler whoami`.
//
// NOTE (wrangler schema): `containers` is NOT inherited into named
// environments: every env block repeats it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiero-dev-media-worker",
  // Worker entry wrapping the container's Durable Object (class exported by
  // src/index.ts; serves the same protocol with or without the container).
  "main": "src/index.ts",
  // Raised together with the wrangler >= 4.130 pin in the root manifest.
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // The container's Durable Object must be declared as a binding of this
  // same script (wrangler requirement for Containers; verified by dry-run).
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_WORKER",
        "class_name": "MediaWorkerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MediaWorkerContainer"]
    }
  ],
  "containers": [
    {
      "name": "kiero-dev-media-container",
      // node:22-slim + ffmpeg, zero-build Node entry (see ./Dockerfile).
      "image": "./Dockerfile",
      "class_name": "MediaWorkerContainer",
      "instance_type": "dev",
      "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
      "scheduling_policy": "default"
    }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "R2_MEDIA_BUCKET": "kiero-dev-media",
    "R2_MEDIA_ENDPOINT": "",
    "CONVEX_SITE_URL": ""
  },
  "env": {
    "staging": {
      "name": "kiero-staging-media-worker",
      "durable_objects": {
        "bindings": [
          {
            "name": "MEDIA_WORKER",
            "class_name": "MediaWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-staging-media-container",
          "image": "./Dockerfile",
          "class_name": "MediaWorkerContainer",
          "instance_type": "dev",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "R2_MEDIA_BUCKET": "kiero-staging-media",
        // The endpoint names on staging are owned by the SECRET plane
        // (the descriptor's runtimeSecrets compose the EU S3 URLs from the
        // nonsecret account id at deploy time); a committed empty var would
        // collide with the secret binding (Cloudflare code 10053).
        // The staging deployment's HTTP actions origin (public URL, not a
        // secret).
        "CONVEX_SITE_URL": "https://outgoing-marlin-429.eu-west-1.convex.site"
      }
    },
    "alpha-production": {
      "name": "kiero-alpha-media-worker",
      "durable_objects": {
        "bindings": [
          {
            "name": "MEDIA_WORKER",
            "class_name": "MediaWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-alpha-media-container",
          "image": "./Dockerfile",
          "class_name": "MediaWorkerContainer",
          "instance_type": "basic",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "alpha-production",
        "R2_MEDIA_BUCKET": "kiero-alpha-media",
        "R2_MEDIA_ENDPOINT": "",
        "CONVEX_SITE_URL": ""
      }
    }
  }
}
