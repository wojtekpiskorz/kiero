// apps/backup-worker/wrangler.jsonc: the EU backup Container executor
// (complete database + media backup sets).
//
// The TOP-LEVEL block targets LOCAL DEV names only; staging/alpha are named
// environments (`--env staging` / `--env alpha-production`) and can never be
// hit by a bare `wrangler deploy`.
//
// EU placement: the container jurisdiction constraints are SET in every
// scope, as for the media worker.
//
// Scheduled trigger: daily at 02:00 UTC during the pre-user phase (owner
// decision 2026-09-25, docs/adr/mvp-cost-envelope-2026-09.md; the alpha
// cadence of 15 minutes returns with the first users). The Convex-side
// backup-schedule-tick in convex/crons.ts runs an hour later and pings this
// worker's /run when the day's slot has no row. tests/i5 keeps this trigger
// equal to infra/backups/retention.json.
//
// The backup bucket (kiero-dev-backup) was created with
// `wrangler r2 bucket create kiero-dev-backup --jurisdiction eu --location
// weur` and is addressed ONLY through its own per-bucket S3 API token
// (R2_BACKUP_*), never through media credentials
// (infra/bindings/backup-worker.md).
// No account_id committed; the account comes from `wrangler whoami`.
//
// NOTE (wrangler schema): `containers` and `durable_objects` are NOT
// inherited into named environments: every env block repeats them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiero-dev-backup-worker",
  // Worker entry wrapping the container's Durable Object (class exported by
  // src/index.ts; proxies /run to the EU container instance).
  "main": "src/index.ts",
  // Raised together with the wrangler >= 4.130 pin in the root manifest.
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // The daily scheduled backup trigger (pre-user cadence).
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  // The container's Durable Object must be declared as a binding of this
  // same script (wrangler requirement for Containers).
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKUP_WORKER",
        "class_name": "BackupWorkerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackupWorkerContainer"]
    }
  ],
  "containers": [
    {
      "name": "kiero-dev-backup-container",
      // node:22-slim + the pinned Convex CLI, zero-build Node entry
      // (see ./Dockerfile).
      "image": "./Dockerfile",
      // The Dockerfile COPYs repo-level paths (the executor mirrors the two
      // cross-tree convex modules it imports), so the build context is the
      // repo root; the root .dockerignore keeps it to exactly those paths.
      "image_build_context": "../../",
      "class_name": "BackupWorkerContainer",
      "instance_type": "dev",
      "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
      "scheduling_policy": "default"
    }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "R2_BACKUP_BUCKET": "kiero-dev-backup",
    "R2_BACKUP_ENDPOINT": "",
    "R2_MEDIA_BUCKET": "kiero-dev-media",
    "R2_MEDIA_ENDPOINT": "",
    "CONVEX_SITE_URL": "",
    "CONVEX_EXPORT_DEPLOYMENT": ""
  },
  "env": {
    "staging": {
      "name": "kiero-staging-backup-worker",
      "triggers": {
        "crons": ["0 2 * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "BACKUP_WORKER",
            "class_name": "BackupWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-staging-backup-container",
          "image": "./Dockerfile",
          "image_build_context": "../../",
          "class_name": "BackupWorkerContainer",
          "instance_type": "dev",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "R2_BACKUP_BUCKET": "kiero-staging-backup",
        // R2 endpoints stay EMPTY in committed config: the EU S3 endpoint
        // embeds the account id, which the shape-check secret-leak heuristic
        // (rightly) forbids outside evidence docs. The endpoints are
        // injected at deploy time from the same store as the per-bucket R2
        // credentials.
        "R2_MEDIA_BUCKET": "kiero-staging-media",
        // The staging deployment's HTTP actions origin (public URL, not a
        // secret).
        "CONVEX_SITE_URL": "https://outgoing-marlin-429.eu-west-1.convex.site",
        // The staging deployment the pinned `convex export` targets (a
        // reference, not a credential; the access token is the
        // CONVEX_BACKUP_ADMIN_KEY secret).
        "CONVEX_EXPORT_DEPLOYMENT": "wojtek-piskorz-jr:kiero-dev-core:staging"
      }
    },
    "alpha-production": {
      "name": "kiero-alpha-backup-worker",
      "triggers": {
        "crons": ["0 2 * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "BACKUP_WORKER",
            "class_name": "BackupWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-alpha-backup-container",
          "image": "./Dockerfile",
          "image_build_context": "../../",
          "class_name": "BackupWorkerContainer",
          "instance_type": "basic",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "alpha-production",
        "R2_BACKUP_BUCKET": "kiero-alpha-backup",
        "R2_BACKUP_ENDPOINT": "",
        "R2_MEDIA_BUCKET": "kiero-alpha-media",
        "R2_MEDIA_ENDPOINT": "",
        "CONVEX_SITE_URL": "",
        "CONVEX_EXPORT_DEPLOYMENT": ""
      }
    }
  }
}
