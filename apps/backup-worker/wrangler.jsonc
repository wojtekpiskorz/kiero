// apps/backup-worker/wrangler.jsonc: the EU backup Container executor
// (I1 skeleton; completed by I5, issue #57).
//
// The TOP-LEVEL block targets LOCAL DEV names only; staging/alpha are named
// environments (`--env staging` / `--env alpha-production`) and can never be
// hit by a bare `wrangler deploy`.
//
// EU placement (I5): wrangler 4.130.0 is the pinned root devDependency
// (A3), so the container EU jurisdiction constraints are SET in every scope
// (discharging the I5 row of the PENDING table in
// docs/evidence/environment/preflight-2026-09.md - that table stays the
// single ownership source; D6 set the same fields for the media container).
//
// Scheduled trigger: every 15 minutes (the accepted cadence; the Convex-side
// schedule authority is convex/crons.ts backup-schedule-tick, whose safety
// net pings this worker's /run when a slot has no row). Frequency is never
// silently reduced to fit a plan (infra/backups/retention.json).
//
// The backup bucket (kiero-dev-backup) was created by the I5 proof with
// `wrangler r2 bucket create kiero-dev-backup --jurisdiction eu --location
// weur` and is addressed ONLY through its own per-bucket S3 API token
// (R2_BACKUP_*), never through media credentials
// (infra/bindings/backup-worker.md).
// No account_id committed; the account comes from `wrangler whoami`.
//
// NOTE (wrangler schema): `containers` and `durable_objects` are NOT
// inherited into named environments: every env block repeats them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiero-dev-backup-worker",
  // Worker entry wrapping the container's Durable Object (class exported by
  // src/index.ts; proxies /run to the EU container instance).
  "main": "src/index.ts",
  // Raised together with the wrangler >= 4.130 pin (owner A3, root manifest);
  // see the PENDING table in docs/evidence/environment/preflight-2026-09.md.
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // The every-15-minutes scheduled backup trigger (the accepted cadence).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // The container's Durable Object must be declared as a binding of this
  // same script (wrangler requirement for Containers; the D6 pattern).
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKUP_WORKER",
        "class_name": "BackupWorkerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BackupWorkerContainer"]
    }
  ],
  "containers": [
    {
      "name": "kiero-dev-backup-container",
      // I5: node:22-slim + the pinned Convex CLI, zero-build Node entry
      // (see ./Dockerfile).
      "image": "./Dockerfile",
      "class_name": "BackupWorkerContainer",
      "instance_type": "dev",
      "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
      "scheduling_policy": "default"
    }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "R2_BACKUP_BUCKET": "kiero-dev-backup",
    "R2_BACKUP_ENDPOINT": "",
    "R2_MEDIA_BUCKET": "kiero-dev-media",
    "R2_MEDIA_ENDPOINT": "",
    "CONVEX_SITE_URL": "",
    "CONVEX_EXPORT_DEPLOYMENT": ""
  },
  "env": {
    "staging": {
      "name": "kiero-staging-backup-worker",
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "BACKUP_WORKER",
            "class_name": "BackupWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-staging-backup-container",
          "image": "./Dockerfile",
          "class_name": "BackupWorkerContainer",
          "instance_type": "dev",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "R2_BACKUP_BUCKET": "kiero-staging-backup",
        "R2_BACKUP_ENDPOINT": "",
        "R2_MEDIA_BUCKET": "kiero-staging-media",
        "R2_MEDIA_ENDPOINT": "",
        "CONVEX_SITE_URL": "",
        "CONVEX_EXPORT_DEPLOYMENT": ""
      }
    },
    "alpha-production": {
      "name": "kiero-alpha-backup-worker",
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "BACKUP_WORKER",
            "class_name": "BackupWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-alpha-backup-container",
          "image": "./Dockerfile",
          "class_name": "BackupWorkerContainer",
          "instance_type": "basic",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "alpha-production",
        "R2_BACKUP_BUCKET": "kiero-alpha-backup",
        "R2_BACKUP_ENDPOINT": "",
        "R2_MEDIA_BUCKET": "kiero-alpha-media",
        "R2_MEDIA_ENDPOINT": "",
        "CONVEX_SITE_URL": "",
        "CONVEX_EXPORT_DEPLOYMENT": ""
      }
    }
  }
}
