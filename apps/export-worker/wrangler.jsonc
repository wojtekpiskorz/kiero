// apps/export-worker/wrangler.jsonc: the EU export Container executor
// (bounded firm-export archives).
//
// The TOP-LEVEL block targets LOCAL DEV names only; staging/alpha are named
// environments (`--env staging` / `--env alpha-production`) and can never be
// hit by a bare `wrangler deploy`.
//
// EU placement: the container jurisdiction constraints are SET in every
// scope, as for the media worker.
//
// Environment contract (infra/bindings/media-export-workers.md): this
// worker binds NO R2 bucket and holds NO backup credentials. The EU media
// bucket is addressed via the media S3 token
// (R2_MEDIA_ENDPOINT / R2_MEDIA_BUCKET / R2_MEDIA_ACCESS_KEY_ID /
// R2_MEDIA_SECRET_ACCESS_KEY); the S3 keys are Worker SECRETS injected with
// `wrangler secret put` and forwarded into the container env by NAME.
//
// No account_id committed; the account comes from `wrangler whoami`.
//
// NOTE (wrangler schema): `containers` is NOT inherited into named
// environments: every env block repeats it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiero-dev-export-worker",
  // Worker entry wrapping the container's Durable Object (class exported by
  // src/index.ts; serves the same protocol with or without the container).
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // The container's Durable Object must be declared as a binding of this
  // same script (wrangler requirement for Containers).
  "durable_objects": {
    "bindings": [
      {
        "name": "EXPORT_WORKER",
        "class_name": "ExportWorkerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExportWorkerContainer"]
    }
  ],
  "containers": [
    {
      "name": "kiero-dev-export-container",
      // node:22-slim, zero-build Node entry (see ./Dockerfile).
      "image": "./Dockerfile",
      // The Dockerfile COPYs repo-level paths (the container mirrors the
      // one cross-tree protocol module it imports), so the build context is
      // the repo root; the root .dockerignore keeps it to exactly those
      // paths (as for the backup worker).
      "image_build_context": "../../",
      "class_name": "ExportWorkerContainer",
      "instance_type": "dev",
      "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
      "scheduling_policy": "default"
    }
  ],
  "vars": {
    "ENVIRONMENT": "dev",
    "R2_MEDIA_BUCKET": "kiero-dev-media",
    "R2_MEDIA_ENDPOINT": "",
    "CONVEX_SITE_URL": ""
  },
  "env": {
    "staging": {
      "name": "kiero-staging-export-worker",
      "durable_objects": {
        "bindings": [
          {
            "name": "EXPORT_WORKER",
            "class_name": "ExportWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-staging-export-container",
          "image": "./Dockerfile",
          "image_build_context": "../../",
          "class_name": "ExportWorkerContainer",
          "instance_type": "dev",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "R2_MEDIA_BUCKET": "kiero-staging-media",
        // The endpoint names on staging are owned by the SECRET plane
        // (the descriptor's runtimeSecrets compose the EU S3 URLs from the
        // nonsecret account id at deploy time); a committed empty var would
        // collide with the secret binding (Cloudflare code 10053).
        // The staging deployment's HTTP actions origin (public URL, not a
        // secret).
        "CONVEX_SITE_URL": "https://outgoing-marlin-429.eu-west-1.convex.site"
      }
    },
    "alpha-production": {
      "name": "kiero-alpha-export-worker",
      "durable_objects": {
        "bindings": [
          {
            "name": "EXPORT_WORKER",
            "class_name": "ExportWorkerContainer"
          }
        ]
      },
      "containers": [
        {
          "name": "kiero-alpha-export-container",
          "image": "./Dockerfile",
          "image_build_context": "../../",
          "class_name": "ExportWorkerContainer",
          "instance_type": "basic",
          "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
          "scheduling_policy": "default"
        }
      ],
      "vars": {
        "ENVIRONMENT": "alpha-production",
        "R2_MEDIA_BUCKET": "kiero-alpha-media",
        "R2_MEDIA_ENDPOINT": "",
        "CONVEX_SITE_URL": ""
      }
    }
  }
}
