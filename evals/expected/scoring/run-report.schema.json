{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kiero/scoring/run-report.schema.json",
  "title": "Kiero scorer input: per-case run report",
  "description": "The INPUT contract a future runner (D6/J3) must produce per corpus case. The scorer compares this report against the independent answer key in evals/expected/<caseId>.json. The runner is NOT part of E1; no model calls were made.",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "corpusRevision", "run", "configuration", "latencyMs", "attempts", "cost", "stages", "caseScore", "caseOutcome"],
  "properties": {
    "caseId": { "type": "string", "pattern": "^(T(0[1-9]|1[0-4])|V(0[1-9]|1[0-6])|I(0[1-9]|1[0-2])|M0[1-8])$" },
    "corpusRevision": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$", "description": "Corpus revision the run executed against; results are only comparable within one revision." },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "attempt", "startedAt", "finishedAt"],
      "properties": {
        "runId": { "type": "string", "minLength": 1, "description": "One of the three complete qualification runs." },
        "attempt": { "type": "integer", "minimum": 1 },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" },
        "environment": { "type": "string", "description": "e.g. local dev, synthetic staging." },
        "revision": { "type": "string", "description": "Exact application code revision under test." }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat"],
      "properties": {
        "chat": { "$ref": "#/definitions/componentConfig" },
        "stt": { "$ref": "#/definitions/componentConfig" },
        "vision": { "$ref": "#/definitions/componentConfig" },
        "embedding": { "$ref": "#/definitions/componentConfig" }
      }
    },
    "latencyMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstUsefulOutputMs", "totalMs"],
      "properties": {
        "firstUsefulOutputMs": { "type": "integer", "minimum": 0 },
        "totalMs": { "type": "integer", "minimum": 0 }
      }
    },
    "attempts": { "type": "integer", "minimum": 1 },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amountUsd", "metered"],
      "properties": {
        "amountUsd": { "type": "string", "pattern": "^\\d+\\.\\d{4}$" },
        "metered": { "type": "boolean" }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stt", "vision", "retrieval", "memoryChanges", "clarifications"],
      "properties": {
        "stt": { "$ref": "#/definitions/stageOutcome" },
        "vision": { "$ref": "#/definitions/stageOutcome" },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidenceReturned"],
          "properties": {
            "status": { "$ref": "#/definitions/stageStatus" },
            "evidenceReturned": { "type": "array", "items": { "type": "string" }, "description": "sourceIds whose fragments were actually returned and hydrated." }
          }
        },
        "memoryChanges": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "published"],
          "properties": {
            "status": { "$ref": "#/definitions/stageStatus" },
            "published": {
              "type": "array",
              "minItems": 1,
              "description": "PUBLISHED SEMANTICS: ordered per-beat snapshots mirroring the answer key's stages array. One snapshot per expected stage, in the same order, each carrying stageId copied from the key. Each snapshot lists the FULL current state at that beat of every finding the run touched: exactly one entry per findingKey+scope (duplicates are ambiguous publication and fail). The last snapshot is the final state after the whole case timeline (all sources processed, all run_completion beats done, lifecycle ops applied). Entries matching no expected change at any stage are extra writes and fail. Missing stageId snapshots fail.",
              "items": { "$ref": "#/definitions/beatSnapshot" }
            }
          }
        },
        "clarifications": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "asked"],
          "properties": {
            "status": { "$ref": "#/definitions/stageStatus" },
            "asked": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ambiguity", "asksAbout"],
                "properties": { "ambiguity": { "type": "string" }, "asksAbout": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "caseScore": { "type": "number", "minimum": 0, "maximum": 1, "description": "Aggregate per-case score from whatever rubric the runner uses. IRRELEVANT to critical-error detection: a critical error fails the case at any score." },
    "caseOutcome": {
      "enum": ["pass", "fail", "incomplete", "provider_unavailable"],
      "description": "provider_unavailable is recorded separately from incorrect reasoning and never silently mapped to pass or fail."
    }
  },
  "definitions": {
    "publishedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingKey", "scope", "knowledgeState"],
      "properties": {
        "findingKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "ref"],
          "properties": { "level": { "enum": ["project", "company"] }, "ref": { "type": "string" } }
        },
        "operation": {
          "type": "string",
          "description": "The operation that produced this current value: set, supersede, mark_unknown, mark_conflicted, mark_not_applicable or create_project. Verified for the state-changing operations (mark_*, create_project); set and supersede are verified through value, knowledgeState and beats."
        },
        "knowledgeState": { "enum": ["known", "unknown", "conflicted", "not_applicable"] },
        "value": { "type": "object" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceId"],
            "properties": { "sourceId": { "type": "string" }, "anchor": { "type": "object" } }
          }
        }
      }
    },
    "beatSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stageId", "changes"],
      "properties": {
        "stageId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{2,32}$",
          "description": "Mirrors the answer key's stageId for this beat."
        },
        "changes": {
          "type": "array",
          "items": { "$ref": "#/definitions/publishedChange" }
        }
      }
    },
    "componentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "route": { "type": "string" },
        "promptVersion": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "stageStatus": { "enum": ["skipped", "complete", "partial", "failed"] },
    "stageOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/definitions/stageStatus" },
        "notes": { "type": "string", "description": "e.g. which segments are missing; missing segments stay explicitly incomplete." }
      }
    }
  }
}
